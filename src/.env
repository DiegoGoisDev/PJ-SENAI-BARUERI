# Configurações do Servidor
PORT=3000

# Chave da OpenAI API — cole a SUA chave real (começa com sk-...)
# Enquanto estiver com o valor de exemplo abaixo, o chat roda em modo local (respostas fixas).
OPENAI_API_KEY=sua_chave_openai_aqui

# URL base da API (opcional - padrão: https://api.openai.com/v1)
OPENAI_API_URL=https://api.openai.com/v1

# Modelo da OpenAI (opcional - padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
